<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The Linux host. Like AtE.Core it targets the neutral net9.0 TFM (no -windows
         suffix, no WinForms, no SharpDX) so it builds on Linux. It holds the Linux seam
         backends (currently stubs: memory -> input -> render -> window), the LinuxPlatform
         composition root, and a scaffolded entry point (Program.cs). The entry point wires
         Platform.Current but cannot drive the app until the shared orchestration core is
         extracted into AtE.Core (see PORTING.md step 6 follow-ups). -->
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>AtE</RootNamespace>
    <AssemblyName>AtE.Linux</AssemblyName>
    <StartupObject>AtE.LinuxProgram</StartupObject>

    <!-- The PoE process is 64-bit; cross-process reads happen in the 64-bit host. -->
    <Platforms>AnyCPU;x64</Platforms>

    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Keep behaviour/conventions consistent with AtE.Core and AtE.Windows. -->
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- The platform-neutral seam interfaces (IProcessMemory, IInputSink, IInputSource,
       IRenderer, IOverlayWindow, VKey/MouseBtn/MemoryRegion) live in AtE.Core. -->
  <ItemGroup>
    <ProjectReference Include="..\AtE.Core\AtE.Core.csproj" />
  </ItemGroup>

  <!-- Runtime assets live in AtE.Core\Static (shared by both hosts). Link them in here so they copy
       to this host's output under "Static\", rather than duplicating the binaries. LinuxRenderer
       decodes Sprites.png from the relative path "Static/Sprites.png" (resolved against the process
       working directory), exactly as SpriteController does on Windows. GreenFlask.ico is carried for
       a later use in the Linux backend (e.g. the overlay's window icon). -->
  <ItemGroup>
    <Content Include="..\AtE.Core\Static\Sprites.png" Link="Static\Sprites.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\AtE.Core\Static\GreenFlask.ico" Link="Static\GreenFlask.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- The native Oodle decoder (libooz) is declared once in AtE.Core and flows into this output
       through the ProjectReference above. No prebuilt libooz.so is committed yet — see
       AtE.Core/Native/README.md for the cmake recipe and where to drop the result. -->

</Project>
