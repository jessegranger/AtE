<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Loot filter generator: compiles a .filtersrc (filter + Style macros) into a plain PoE .filter. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>AtE.FilterGen</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

</Project>
