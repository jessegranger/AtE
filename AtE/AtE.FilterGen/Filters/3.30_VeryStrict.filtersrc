# !! Waypoint c11.leveling.act12.all : "Leveling - Normal and Magic - Act1, Act2 special gear" : "Leveling"

Show # %D4 $type->leveling->normalmagic->act1 $tier->casterweapons !leveling_casterweapon
	Sockets >= 3
	Rarity Magic
	Class == "Sceptres" "Wands"
	AreaLevel <= 16
	SetStyle LevelingCasterweapon

Show # %D4 $type->leveling->normalmagic->act1 $tier->castercraftrings !leveling_act1
	Rarity Normal Magic
	BaseType == "Iron Ring" "Ruby Ring" "Sapphire Ring" "Topaz Ring" "Two-Stone Ring"
	AreaLevel <= 16
	SetStyle LevelingAct1

Show # %D4 $type->leveling->normalmagic->act1 $tier->general !leveling_act1
	Rarity Normal Magic
	BaseType == "Amber Amulet" "Chain Belt" "Coral Ring" "Jade Amulet" "Lapis Amulet" "Leather Belt"
	AreaLevel <= 16
	SetStyle LevelingAct1

Show # %D4 $type->leveling->normalmagic->act1 $tier->boots !leveling_act1
	Rarity Magic
	Class == "Boots"
	AreaLevel <= 16
	SetStyle LevelingAct1

Show # %D4 $type->leveling->normalmagic->act1 $tier->quivers !leveling_rarearcher
	Rarity Normal Magic
	Class == "Quivers"
	AreaLevel <= 16
	SetStyle LevelingRarearcher

