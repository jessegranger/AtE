#------------------------------------
#   [2603] Abyss Jewels
#------------------------------------
# !! Waypoint c7.jewels.abyss.all : "Jewels - Abyss Jewels" : "Jewels and Cluster Jewels"

Show # %H7 $type->jewels->abyss $tier->extramodcorruptedabyssjewel !exotics_t2
	Corrupted True
	Rarity Rare
	Class == "Abyss Jewels"
	HasExplicitMod >=5 "a" "e" "i" "o" "u" "y"
	SetStyle ExoticsT2

Show # %H5 $type->jewels->abyss $tier->corruptedabyssjewel !jewels_rareveryhigh
	Corrupted True
	Rarity Rare
	Class == "Abyss Jewels"
	SetStyle JewelsRareveryhigh

Show # %H5 $type->jewels->abyss $tier->veryhighrare !jewels_rareveryhigh
	ItemLevel >= 86
	Rarity Rare
	Class == "Abyss Jewels"
	SetStyle JewelsRareveryhigh

Show # %HS4 $type->jewels->abyss $tier->veryhighmagic !jewels_abyss1
	ItemLevel >= 86
	Rarity Normal Magic
	Class == "Abyss Jewels"
	SetStyle JewelsAbyss1

Show # %HS4 $type->jewels->abyss $tier->highrare !jewels_rarehigh
	ItemLevel >= 82
	Rarity Rare
	Class == "Abyss Jewels"
	SetStyle JewelsRarehigh

Show # %HS3 $type->jewels->abyss $tier->highmagic !jewels_abyss2
	ItemLevel >= 82
	Rarity Normal Magic
	Class == "Abyss Jewels"
	SetStyle JewelsAbyss2

Show # %HS3 $type->jewels->abyss $tier->anyrare !jewels_rare
	Rarity Rare
	Class == "Abyss Jewels"
	SetStyle JewelsRare

Hide # %H2 $type->jewels->abyss $tier->anymagic !jewels_abysslvl
	Rarity Normal Magic
	Class == "Abyss Jewels"
	SetStyle JewelsAbysslvl

#------------------------------------
#   [2604] Generic Jewels
#------------------------------------
# !! Waypoint c7.jewels.generic.all : "Jewels - Generic Jewels"

Show # %HS3 $type->jewels->generic $tier->anyrare !jewels_rare
	Rarity Rare
	BaseType == "Cobalt Jewel" "Crimson Jewel" "Viridian Jewel"
	SetStyle JewelsRare

Hide # %H2 $type->jewels->generic $tier->anymagic !jewels_abysslvl
	Rarity Normal Magic
	BaseType == "Cobalt Jewel" "Crimson Jewel" "Viridian Jewel"
	SetStyle JewelsAbysslvl

#------------------------------------
#   [2605] Cluster Jewels: Eco-Based-Large
#------------------------------------
# !! Waypoint c7.jewels.cluster.all : "Jewels - Cluster - Economy-Based-Tiering" : "Jewels and Cluster Jewels"

Show # $type->jewels->clustereco $tier->n12_i84_t1 !apex_sjewel
	ItemLevel >= 84
	Rarity Normal Magic Rare
	EnchantmentPassiveNum 12
	BaseType == "Large Cluster Jewel"
	EnchantmentPassiveNode == "Attack Damage while holding a Shield" "Chaos Damage" "Dagger and Claw Damage" "Lightning Damage" "Minion Damage" "Spell Damage"
