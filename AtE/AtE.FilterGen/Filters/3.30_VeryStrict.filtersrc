	Class == "Trinkets"
	SetStyle ExoticsArtefact

Show # $type->artefact->misc $tier->fishingrods !exotics_artefact
	Class == "Fishing Rods"
	SetStyle ExoticsArtefact

Show # $type->artefact->misc $tier->pieces !exotics_artefact
	Rarity Unique
	Class == "Pieces"
	SetStyle ExoticsArtefact

Show # $type->questlikeexception $tier->questheist !utility_quest
	Class == "Quest Items"
	BaseType "Contract:"
	SetStyle UtilityQuest

Show # $type->questlikeexception $tier->questitems !utility_quest
