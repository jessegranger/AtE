#------------------------------------
#   [5205] Remaining Magics
#------------------------------------

Show # $type->decorators->leveling->magic $tier->medium1 !deco_bluemedium
	Width 1
	Height >= 3
	ItemLevel <= 67
	Rarity Magic
	SetStyle DecoBluemedium
	Continue

Show # $type->decorators->leveling->magic $tier->medium2 !deco_bluemedium
	Width 2
	Height 2
	ItemLevel <= 67
	Rarity Magic
	SetStyle DecoBluemedium
	Continue

Show # $type->decorators->leveling->magic $tier->noticeearly !deco_bluemedium
	ItemLevel <= 67
	Rarity Magic
	AreaLevel <= 9
	SetStyle DecoBluemedium
	Continue

Show # $type->decorators->leveling->magic $tier->tiny !deco_bluetiny
	Width <= 2
	Height 1
	ItemLevel <= 67
	Rarity Magic
	SetStyle DecoBluetiny
	Continue

# !! Waypoint c11.leveling.magicvendor.all : "Leveling - Normal and Magic - Magic Vendor Items" : "Leveling"

Hide # $type->leveling->magic->remaining $tier->largemagicblocker !utility_layer
	Width >= 2
	Height >= 3
	Rarity Magic
	Class == "Amulets" "Belts" "Body Armours" "Boots" "Bows" "Claws" "Daggers" "Gloves" "Helmets" "One Hand Axes" "One Hand Maces" "One Hand Swords" "Quivers" "Rings" "Rune Daggers" "Sceptres" "Shields" "Staves" "Thrusting One Hand Swords" "Two Hand Axes" "Two Hand Maces" "Two Hand Swords" "Wands" "Warstaves"
	AreaLevel >= 16
	SetStyle UtilityLayer

