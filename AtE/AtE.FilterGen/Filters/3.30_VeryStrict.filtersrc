#===============================================================================================================
# [[0100]] Global overriding rules
#===============================================================================================================
# !! Waypoint c0.alpha : "All Rules - Highest priority - DANGER ZONE" : "Recipes and Linked Gear"

Show # %D8 $type->6l $tier->hightier !links_6lt1
	Mirrored False
	Corrupted False
	LinkedSockets 6
	ItemLevel >= 75
	Rarity Normal Magic Rare
	BaseType == "Apex Cleaver" "Arcane Vestment" "Assassin's Garb" "Astral Leather" "Banishing Blade" "Battery Staff" "Carnal Armour" "Conquest Lamellar" "Despot Axe" "Destiny Leather" "Eventuality Rod" "Exquisite Leather" "Full Dragonscale" "Full Wyvernscale" "General's Brigandine" "Gladiator Plate" "Glorious Plate" "Grand Ringmail" "Grove Bow" "Harbinger Bow" "Impact Force Propagator" "Imperial Bow" "Ivory Bow" "Legion Plate" "Maraketh Bow" "Marshall's Brigandine" "Necrotic Armour" "Nightweave Robe" "Paladin's Hauberk" "Royal Plate" "Sacred Chainmail" "Sadist Garb" "Saint's Hauberk" "Saintly Chainmail" "Sanguine Raiment" "Short Bow" "Solarine Bow" "Spine Bow" "Supreme Leather" "Syndicate's Garb" "Thicket Bow" "Titan Plate" "Torturer Garb" "Triumphant Lamellar" "Twilight Regalia" "Vaal Regalia" "Zodiac Leather"
	SetStyle Links6lt1

Show # %D5 $type->6l $tier->others !links_6lt2
	LinkedSockets 6
	Rarity Normal Magic Rare
	SetStyle Links6lt2

#===============================================================================================================
# [[0200]] Gold
#===============================================================================================================
# !! Waypoint c0.gold : "All Rules - Including Gold" : "Gold"

Show # %H7 $type->gold $tier->stack3 !gold_huge
	StackSize >= 3001
	BaseType == "Gold"
	SetStyle GoldHuge

Show # %H6 $type->gold $tier->stack2 !gold_large
	StackSize >= 500
	BaseType == "Gold"
	SetStyle GoldLarge

Show # %H5 $type->gold $tier->stack1 !gold_medium
	StackSize >= 150
	BaseType == "Gold"
	SetStyle GoldMedium

Show # %H5 $type->gold $tier->stacklvl1 !gold_medium
	StackSize >= 50
	BaseType == "Gold"
	AreaLevel <= 68
	SetStyle GoldMedium

Show # %H4 $type->gold $tier->anyother !gold_small
	BaseType == "Gold"
	SetStyle GoldSmall

#===============================================================================================================
# [[0300]] Influenced Items
#===============================================================================================================
#------------------------------------
#   [0301] Influenced Maps
#------------------------------------
# !! Waypoint c1.infl.allplusmaps : "All rules - except gold and six-links" : "Maps"

#Hide # $type->maps->influenced $tier->zanacorrupthider !utility_shrunk
#	ZanaMemory True
#	Corrupted True
#	Rarity Normal Magic
#	Class == "Maps"
#	SetFontSize 35
#	SetBorderColor 0 0 0

Show # %H8 $type->maps->influenced $tier->zanamap !maps_t1
	ZanaMemory True
	MapTier >= 14
	Rarity Normal Magic Rare
	Class == "Maps"
	SetStyle MapsT1

Show # %H6 $type->maps->influenced $tier->zanamaplow !maps_t2exotic
	ZanaMemory True
	Rarity Normal Magic Rare
	Class == "Maps"
	SetStyle MapsT2exotic

Show # %H7 $type->maps->influenced $tier->infelder !maps_t1
	HasInfluence Elder
	MapTier >= 16
	Rarity Normal Magic Rare
	Class == "Maps"
	SetStyle MapsT1

Show # %H8 $type->maps->influenced $tier->infconquerors !maps_t1
	HasInfluence Crusader Hunter Redeemer Warlord
	Rarity Normal Magic Rare
	Class == "Maps"
	SetStyle MapsT1

