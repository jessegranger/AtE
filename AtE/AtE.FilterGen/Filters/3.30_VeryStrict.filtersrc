#------------------------------------
#   [5202] Normals
#------------------------------------
# !! Waypoint c11.leveling.firstlevels.all : "Leveling - Normal and Magic - First Levels" : "Leveling"

Hide # %H2 $type->leveling->firstlevels $tier->earlybodyarmours !lvlmisc_progression
	Rarity Normal
	Class == "Body Armours"
	AreaLevel >= 2
	AreaLevel <= 9
	SetStyle LvlmiscProgression

Hide # %H3 $type->leveling->firstlevels $tier->threesocketedgear !lvlmisc_3socketearly
	Sockets >= 3
	Rarity Normal Magic
	Class == "Boots" "Gloves" "Helmets" "Sceptres" "Shields" "Wands"
	AreaLevel <= 9
	SetStyle Lvlmisc3socketearly

Hide # %H3 $type->leveling->firstlevels $tier->firstareas !lvlmisc_firstareas
	Rarity Normal
	AreaLevel <= 4
	SetStyle LvlmiscFirstareas

